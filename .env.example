# Copy this file to .env and fill in real values. Never commit the real .env file.

# Same Supabase project the Streamlit app already uses
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-secret-key

# Any long random string â€” used to sign login tokens
JWT_SECRET=change-this-to-a-long-random-string

GEMINI_API_KEY=your-gemini-api-key

RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
PRO_PRICE_INR=99
PRO_DURATION_DAYS=30

# Your frontend's URL â€” Razorpay redirects here after payment
FRONTEND_URL=http://localhost:3000

SMTP_USER=youremail@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# Comma-separated list of frontend URLs allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000

